# ============================================================
# .gitignore — Git 忽略规则
# ============================================================
# 上下文层：定义哪些文件不进版本控制——编译产物、打包输出、IDE 配置等。

# Python 编译产物
*.py[cod]

# demo 生成的 HTML 图表
*.html
*.png

# setuptools_scm 自动生成的版本号
_version.py

# 打包构建产物
*.egg-info
.eggs/*
__pycache__/*
dist/*

# coverage.py 覆盖率报告
.coverage
.coverage.*
htmlcov/*

# 文档构建输出（doc/ 已从课程分支删除）
doc/build/*
build/*

# IDE 项目配置
.idea/*
.vscode/

# Jupyter 检查点
**/.ipynb_checkpoints

# 编辑器备份
*~*

# 虚拟环境
.venv/
