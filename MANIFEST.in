# ============================================================
# MANIFEST.in — 源码分发包（sdist）文件清单
# ============================================================
# 上下文层：控制 `python -m build` 打包时包含/排除哪些文件。

exclude MANIFEST.in             # 不打包自身
exclude .*                      # 排除隐藏文件

recursive-exclude .* *          # 子目录同样排除隐藏文件
recursive-exclude doc *         # doc/ 全部不打包
